local function isEnemy(player)[cite: 5]
    if player == LocalPlayer then return false end[cite: 5]
    local rageEnabled = Toggles.RageToggle and Toggles.RageToggle.Value[cite: 5]
    if rageEnabled then[cite: 5]
        local myTeam = LocalPlayer:GetAttribute("TeamID")[cite: 5]
        local theirTeam = player:GetAttribute("TeamID")[cite: 5]
        if myTeam == nil or theirTeam == nil then return true end[cite: 5]
        return theirTeam ~= myTeam[cite: 5]
    end[cite: 5]
    return true[cite: 5]
end[cite: 5]

local function isProtected(character)[cite: 5]
    if not character then return true end[cite: 5]
    if character:FindFirstChild("InvincibilityParticles", true) then return true end[cite: 5]
    if character:GetAttribute("SpawnProtection") == true or character:GetAttribute("Invincible") == true then[cite: 5]
        return true[cite: 5]
    end[cite: 5]
    return false[cite: 5]
end[cite: 5]

local function getEquippedObjId()[cite: 5]
    if not controllers then return nil end[cite: 5]
    local ok, FighterCtrl = pcall(function() return require(controllers.FighterController) end)[cite: 5]
    if not ok or not FighterCtrl or not FighterCtrl.LocalFighter then return nil end[cite: 5]
    local item = FighterCtrl.LocalFighter.EquippedItem[cite: 5]
    if not item then return nil end[cite: 5]
    local okId, id = pcall(function() return item:Get("ObjectID") end)[cite: 5]
    if okId and id then return id end[cite: 5]
    local okData, idData = pcall(function() return item.Data and item.Data.ObjectID end)[cite: 5]
    return okData and idData or nil[cite: 5]
end[cite: 5]

local function getTargetEquippedWeaponName(targetPlayer)[cite: 5]
    local weaponName = ""[cite: 5]
    pcall(function()[cite: 5]
        if FighterController then[cite: 5]
            local fighter = FighterController:GetFighter(targetPlayer)[cite: 5]
            if fighter and fighter.EquippedItem then[cite: 5]
                weaponName = fighter.EquippedItem.Name or ""[cite: 5]
            end[cite: 5]
        end[cite: 5]
    end)[cite: 5]
    if weaponName == "" then[cite: 5]
        local char = targetPlayer.Character[cite: 5]
        if char then[cite: 5]
            for _, child in ipairs(char:GetChildren()) do[cite: 5]
                if child:IsA("Tool") or child:FindFirstChild("Handle") then[cite: 5]
                    weaponName = child.Name[cite: 5]
                    break[cite: 5]
                end[cite: 5]
            end[cite: 5]
        end[cite: 5]
    end[cite: 5]
    return weaponName[cite: 5]
end[cite: 5]

local function getStickyTarget()[cite: 5]
    if RageModule.LockedTarget and RageModule.LockedTarget.Character then[cite: 5]
        local char = RageModule.LockedTarget.Character[cite: 5]
        local hum = char:FindFirstChildWhichIsA("Humanoid")[cite: 5]
        local hrp = char:FindFirstChild("HumanoidRootPart")[cite: 5]
        if hum and hum.Health > 0 and hrp and not isProtected(char) then[cite: 5]
            return RageModule.LockedTarget[cite: 5]
        else[cite: 5]
            RageModule.LockedTarget = nil[cite: 5]
        end[cite: 5]
    end[cite: 5]
    
    local bestTarget = nil[cite: 5]
    local minDistance = math.huge[cite: 5]
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")[cite: 5]
    
    for _, player in ipairs(Players:GetPlayers()) do[cite: 5]
        if not isEnemy(player) then continue end[cite: 5]
        local char = player.Character[cite: 5]
        if not char then continue end[cite: 5]
        local hrp = char:FindFirstChild("HumanoidRootPart")[cite: 5]
        local hum = char:FindFirstChildWhichIsA("Humanoid")[cite: 5]
        if not hrp or not hum or hum.Health <= 0 then continue end[cite: 5]
        if isProtected(char) then continue end[cite: 5]
        
        if myHrp then[cite: 5]
            local distToPlayer = (hrp.Position - myHrp.Position).Magnitude[cite: 5]
            if distToPlayer > 600 then continue end[cite: 5]
        end[cite: 5]
        
        local screenPos, isVisible = Camera:WorldToViewportPoint(hrp.Position)[cite: 5]
        if not isVisible then continue end[cite: 5]
        
        local distance = (Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude[cite: 5]
        if distance < minDistance then[cite: 5]
            minDistance = distance[cite: 5]
            bestTarget = player[cite: 5]
        end[cite: 5]
    end[cite: 5]
    
    RageModule.LockedTarget = bestTarget[cite: 5]
    return bestTarget[cite: 5]
end[cite: 5]

local function buildShotData(originPos, targetPart)[cite: 5]
    local targetPos = targetPart.Position[cite: 5]
    local lookCF = CFrame.lookAt(originPos, targetPos)[cite: 5]
    local lX, lY, lZ = lookCF:ToOrientation()[cite: 5]
    local originStruct = {[cite: 5]
        [utf8.char(0)] = originPos.X, [utf8.char(1)] = originPos.Y, [utf8.char(2)] = originPos.Z,[cite: 5]
        [utf8.char(3)] = lX, [utf8.char(4)] = lY, [utf8.char(5)] = lZ,[cite: 5]
    }[cite: 5]
    local relCF = targetPart.CFrame:ToObjectSpace(CFrame.new(targetPos))[cite: 5]
    local rX, rY, rZ = relCF:ToOrientation()[cite: 5]
    return {[cite: 5]
        [utf8.char(1)] = {[cite: 5]
            [utf8.char(0)] = originStruct,[cite: 5]
            [utf8.char(1)] = originStruct,[cite: 5]
            [utf8.char(2)] = targetPart,[cite: 5]
            [utf8.char(3)] = {[cite: 5]
                [utf8.char(0)] = relCF.X, [utf8.char(1)] = relCF.Y, [utf8.char(2)] = relCF.Z,[cite: 5]
                [utf8.char(3)] = rX, [utf8.char(4)] = rY, [utf8.char(5)] = rZ,[cite: 5]
            },[cite: 5]
        }[cite: 5]
    }[cite: 5]
end[cite: 5]

