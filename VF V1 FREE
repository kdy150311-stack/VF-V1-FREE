local loopTimeCounter = 0[cite: 5]
local isAttackingPhase = false[cite: 5]
local katanaPauseUntil = 0[cite: 5]

local function runRageLogic()[cite: 5]
    if not Toggles.RageToggle or not Toggles.RageToggle.Value or not UseItemRemote then return end[cite: 5]

    local char = LocalPlayer.Character[cite: 5]
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")[cite: 5]
    local hum  = char and char:FindFirstChildWhichIsA("Humanoid")[cite: 5]
    if not hrp or not hum then return end[cite: 5]
    
    -- 슬라이딩이나 이동을 강제로 방해하지 않도록 위치 제어를 완화 (공격 페이즈가 아닐 때는 캐릭터를 하늘로 순간이동시켜 원거리 디싱크만 수행하되 플레이어 입력 자체를 막지 않음)[cite: 5]
    local hideTime = Options.HideTimeSlider and Options.HideTimeSlider.Value or 0.33[cite: 5]
    local attackTime = Options.AttackTimeSlider and Options.AttackTimeSlider.Value or 0.05[cite: 5]
    local totalCycle = hideTime + attackTime[cite: 5]
    if totalCycle <= 0 then totalCycle = 0.38 end[cite: 5]

    loopTimeCounter = (loopTimeCounter + RunService.Heartbeat:Wait()) % totalCycle[cite: 5]
    isAttackingPhase = loopTimeCounter >= hideTime[cite: 5]

    if not isAttackingPhase then[cite: 5]
        -- 숨기 페이즈: 캐릭터 물리 제어를 직접 뺏지 않고 위치만 조작[cite: 5]
        pcall(function()[cite: 5]
            hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + 50000, hrp.Position.Z)[cite: 5]
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)[cite: 5]
            hrp.RotVelocity = Vector3.zero[cite: 5]
        end)[cite: 5]
        return[cite: 5]
    end[cite: 5]

    local targetPlayer = getStickyTarget()[cite: 5]
    if targetPlayer and targetPlayer.Character then[cite: 5]
        local tc = targetPlayer.Character[cite: 5]
        local tRoot = tc:FindFirstChild("HumanoidRootPart")[cite: 5]
        local tHead = tc:FindFirstChild("HitboxHeadSmall") or tc:FindFirstChild("HitboxHead") or tc:FindFirstChild("Head")[cite: 5]
        local objId = getEquippedObjId()[cite: 5]
        
        if tRoot and tHead and objId then[cite: 5]
            if not isProtected(tc) then[cite: 5]
                local enemyWeapon = string.lower(getTargetEquippedWeaponName(targetPlayer))[cite: 5]
                
                -- 1. Katana(반사) 감지 시: 발사 중지 및 면역 체크 후 0.5초 대기[cite: 5]
                if enemyWeapon:find("katana") or enemyWeapon:find("sword") or enemyWeapon:find("parry") then[cite: 5]
                    katanaPauseUntil = tick() + 0.5[cite: 5]
                    return[cite: 5]
                end[cite: 5]
                
                if tick() < katanaPauseUntil then[cite: 5]
                    return[cite: 5]
                end[cite: 5]

                local fakePositionCF[cite: 5]
                
                -- 2. Knife(나이프) 들었을 경우: 엄청 위쪽으로 올라가서 공격[cite: 5]
                if enemyWeapon:find("knife") or enemyWeapon:find("dagger") then[cite: 5]
                    fakePositionCF = tRoot.CFrame * CFrame.new(0, 35, 0)[cite: 5]
                -- 3. Riot Shield(라이엇 쉴드/방패) 들었을 경우: 상대의 뒤쪽으로 이동해서 공격[cite: 5]
                elseif enemyWeapon:find("riot") or enemyWeapon:find("shield") then[cite: 5]
                    fakePositionCF = tRoot.CFrame * CFrame.new(0, 0, -6)[cite: 5]
                else[cite: 5]
                    -- 일반적인 경우 칼찌 안 당하는 안전한 공중 높이[cite: 5]
                    fakePositionCF = tRoot.CFrame * CFrame.new(0, 8, 0)[cite: 5]
                end[cite: 5]
                
                local currentRealCF = hrp.CFrame[cite: 5]
                
                hrp.CFrame = fakePositionCF[cite: 5]
                hrp.Velocity = Vector3.zero[cite: 5]
                hrp.RotVelocity = Vector3.zero[cite: 5]
                
                local shootOrigin = tHead.Position + Vector3.new(0, 0.2, 0)[cite: 5]
                local shotData = buildShotData(shootOrigin, tHead)[cite: 5]
                
                if tick() >= RageModule.NextShootAt then[cite: 5]
                    RageModule.NextShootAt = tick() + 0.015[cite: 5]
                    pcall(function()[cite: 5]
                        UseItemRemote:FireServer(objId, StartShootingEnum, shotData, nil)[cite: 5]
                        UseItemRemote:FireServer(objId, StartShootingEnum, shotData, nil)[cite: 5]
                    end)[cite: 5]
                end[cite: 5]
                
                RunService:BindToRenderStep("_SoftRestore", 101, function()[cite: 5]
                    hrp.CFrame = currentRealCF[cite: 5]
                    RunService:UnbindFromRenderStep("_SoftRestore")[cite: 5]
                end)[cite: 5]
            end[cite: 5]
        end[cite: 5]
    else[cite: 5]
        RageModule.LockedTarget = nil[cite: 5]
    end[cite: 5]
end[cite: 5]

