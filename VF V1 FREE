    local bestTarget = nil[cite: 5]
    local bestDist = Options.SilentFOVSlider and Options.SilentFOVSlider.Value or 300[cite: 5]
    local targetPartName = Options.SilentPartDropdown and Options.SilentPartDropdown.Value or "Head"[cite: 5]

    for _, entityModel in CollectionService:GetTagged("Entity") do[cite: 5]
