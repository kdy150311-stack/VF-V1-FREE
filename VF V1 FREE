local function isEnemyAim(p)[cite: 5]
    if p == LocalPlayer then return false end[cite: 5]
    local teamCheckEnabled = Toggles.AimbotTeamCheck and Toggles.AimbotTeamCheck.Value[cite: 5]
    if teamCheckEnabled then[cite: 5]
        local myTeam = LocalPlayer:GetAttribute("TeamID")[cite: 5]
        local theirTeam = p:GetAttribute("TeamID")[cite: 5]
        if myTeam == nil or theirTeam == nil then return true end[cite: 5]
        return theirTeam ~= myTeam[cite: 5]
    end[cite: 5]
    return true[cite: 5]
end[cite: 5]

local function isVisible(targetPart)[cite: 5]
    local char = LocalPlayer.Character[cite: 5]
    if not char then return false end[cite: 5]
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")[cite: 5]
    if not head then return false end[cite: 5]

    local origin = head.Position[cite: 5]
    local direction = (targetPart.Position - origin)[cite: 5]

    local raycastParams = RaycastParams.new()[cite: 5]
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude[cite: 5]
    raycastParams.FilterDescendantsInstances = {char, targetPart.Parent}[cite: 5]
    raycastParams.IgnoreWater = true[cite: 5]

    local result = Workspace:Raycast(origin, direction, raycastParams)[cite: 5]
    return result == nil[cite: 5]
end[cite: 5]

local FOVDrawing = Drawing.new("Circle")[cite: 5]
FOVDrawing.Visible = false[cite: 5]
FOVDrawing.Transparency = 0.7[cite: 5]
