local function getAimbotTarget()[cite: 5]
    local closestTarget = nil[cite: 5]
    local shortestDist = math.huge[cite: 5]
    local mousePos = UserInputService:GetMouseLocation()[cite: 5]
    local useFOV = Toggles.AimbotFOVToggle and Toggles.AimbotFOVToggle.Value[cite: 5]
    local fovRadius = Options.AimbotFOVSlider and Options.AimbotFOVSlider.Value or 150[cite: 5]

    for _, p in ipairs(Players:GetPlayers()) do[cite: 5]
        if isEnemyAim(p) then[cite: 5]
            local hum = p.Character and p.Character:FindFirstChildWhichIsA("Humanoid")[cite: 5]
            if hum and hum.Health > 0 then[cite: 5]
                local char = p.Character[cite: 5]
                local targetPartName = Options.AimbotPartDropdown and Options.AimbotPartDropdown.Value or "Head"[cite: 5]
                local targetPart = char and char:FindFirstChild(targetPartName)[cite: 5]
                
                if targetPart then[cite: 5]
                    if isVisible(targetPart) then[cite: 5]
                        local screenPos, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position)[cite: 5]
                        if onScreen then[cite: 5]
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude[cite: 5]
                            if not useFOV or dist <= fovRadius then[cite: 5]
                                if dist < shortestDist then[cite: 5]
                                    shortestDist = dist[cite: 5]
                                    closestTarget = targetPart[cite: 5]
                                end[cite: 5]
                            end[cite: 5]
                        end[cite: 5]
                    end[cite: 5]
                end[cite: 5]
            end[cite: 5]
        end[cite: 5]
    end[cite: 5]
    return closestTarget[cite: 5]
end[cite: 5]

